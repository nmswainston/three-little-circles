# Copy to .env and fill in. Never commit real values.

# Optional. Leave blank to run fully offline with the bundled content.
# With both set, users can suggest sightings from the app. See supabase/README.md.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Scripts only (npm run content:import, npm run confirmations:pull). Bypasses
# every policy, so it is read from this file on your machine and is never
# bundled into the app.
SUPABASE_SERVICE_ROLE_KEY=

# Required for the native map on Android standalone builds (not needed in Expo Go or on iOS).
# Create a key with the "Maps SDK for Android" API enabled in Google Cloud.
GOOGLE_MAPS_ANDROID_API_KEY=

# Optional. Adds a "Send feedback" button to Profile that opens a prefilled
# email. Leave blank to hide the button. EXPO_PUBLIC_ values are bundled into
# the app, so use an address you are happy for testers to see. Set it in the
# EAS environment as well so builds pick it up.
EXPO_PUBLIC_FEEDBACK_EMAIL=
