# Copy to .env and fill in. Never commit real values.

# Optional. Leave blank to run fully offline with the bundled content.
# With both set, users can suggest sightings from the app. See supabase/README.md.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Scripts only (npm run content:import, npm run confirmations:pull). Bypasses
# every policy, so it is read from this file on your machine and is never
# bundled into the app.
SUPABASE_SERVICE_ROLE_KEY=

# Required for the native map on Android standalone builds (not needed in Expo Go or on iOS).
# Create a key with the "Maps SDK for Android" API enabled in Google Cloud.
GOOGLE_MAPS_ANDROID_API_KEY=

# Optional. Adds a "Send feedback" button to Profile that opens a prefilled
# email. Leave blank to hide the button. EXPO_PUBLIC_ values are bundled into
# the app, so use an address you are happy for testers to see. Set it in the
# EAS environment as well so builds pick it up.
EXPO_PUBLIC_FEEDBACK_EMAIL=

# Optional. "true" turns on the one-time unlock: Magic Kingdom and Disneyland
# Park stay free and every other park waits for the purchase. Leave blank and
# every park is open, as in the current beta. Only turn it on in a build that
# has a purchase provider plugged in (README, "One-time unlock"), or guests
# see a locked park they can't buy.
EXPO_PUBLIC_UNLOCK_ENABLED=

# RevenueCat public SDK keys for the one-time unlock (public by design, they
# ship inside the app). While testing, both can be the project's Test Store
# key (test_...). Store builds need the appl_ (iOS) and goog_ (Android) keys.
# Purchases start only when EXPO_PUBLIC_UNLOCK_ENABLED is also "true".
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
