{
  "name": "three-little-circles",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "prestart": "npm run content:build",
    "start": "expo start",
    "preandroid": "npm run content:build",
    "android": "expo start --android",
    "preios": "npm run content:build",
    "ios": "expo start --ios",
    "preweb": "npm run content:build",
    "web": "expo start --web",
    "content:build": "node scripts/build-entries.mjs",
    "content:check": "node scripts/build-entries.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run content:check && npm run typecheck && npm test",
    "content:import": "node scripts/import-submissions.mjs",
    "confirmations:pull": "node scripts/pull-confirmations.mjs",
    "supabase:check": "node scripts/check-supabase.mjs",
    "content:import-csv": "node scripts/import-csv.mjs",
    "content:reconcile": "node scripts/reconcile-master.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/lilita-one": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.19.1",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.24",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-location": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.3",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.[^/]+/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.[^/]+/"
    ]
  }
}
